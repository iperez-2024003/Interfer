# Server
NODE_ENV=development
PORT=3005

# Docker Compose project name
COMPOSE_PROJECT_NAME=Interfer

#BASE DE DATOS MONGODB
URI_MONGO=mongodb://localhost:27017/Interfer


# Database PostgreSQL
DB_HOST=localhost
DB_PORT=5436
DB_NAME=Interfer
DB_USERNAME=root
DB_PASSWORD=admin
DB_SQL_LOGGING=false

# JWT Configuration
JWT_SECRET=MyVerySecretKeyForJWTTokenAuthenticationWith256Bits!
JWT_EXPIRES_IN=30m
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=AuthService
JWT_AUDIENCE=AuthService

# SMTP Configuration
# Using Ethereal for development - emails will be sent to a test inbox
# You can view them via the preview URL in the registration response
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
# SMTP_USERNAME and SMTP_PASSWORD left empty to use Ethereal fallback
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=noreply@interfer.local
EMAIL_FROM_NAME=Interfer API

# Cloudinary (upload de perfiles)
CLOUDINARY_CLOUD_NAME=dma7p3txk
CLOUDINARY_API_KEY=195347527942465
CLOUDINARY_API_SECRET=fdvbxzdkpoyieszz
CLOUDINARY_BASE_URL=https://res.cloudinary.com/dma7p3txk/image/upload/
CLOUDINARY_FOLDER=interfer/profiles
CLOUDINARY_DEFAULT_AVATAR_FILENAME=default-avatar_ewzxwx.png

# File Upload
UPLOAD_PATH=./uploads

# Frontend URL
FRONTEND_URL=http://localhost:5173

# Security
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
ADMIN_ALLOWED_ORIGINS=http://localhost:5173

# Verification Tokens (en horas)
VERIFICATION_EMAIL_EXPIRY_HOURS=24
PASSWORD_RESET_EXPIRY_HOURS=1